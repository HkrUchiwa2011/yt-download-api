From 76a88d2e4d8c86af4cd2fdde2284a0bc1c3e4f26 Mon Sep 17 00:00:00 2001
From: Kirill Podoprigora <kirill.bast@gmail.com>
Date: Sat, 7 Nov 2026 21:53:13 +0200
Subject: [PATCH] gh-161569: Check cookie policy before deleting expired
 cookies in `http.cookiejar` (GH-161570)

gh-161569: Check cookie policy before deleting expired cookies in http.cookiejar

An expired Set-Cookie header was allowed to delete a stored cookie using
the Domain and Path attributes taken verbatim from the header, before
CookiePolicy.set_ok() was consulted. A response from one host could
therefore delete cookies belonging to any other domain in a shared jar.

The policy is now consulted before an expired cookie may delete an
existing one, as required by RFC 6265 section 5.3.
(cherry picked from commit 8eb3d2c1c41ca7ce628554413981c1eb763a1494)

Co-authored-by: Kirill Podoprigora <kirill.bast@gmail.com>
Co-authored-by: Victor Stinner <vstinner@python.org>
---
 Lib/http/cookiejar.py | policy validation before expiration

diff --git a/Lib/http/cookiejar.py b/Lib/http/cookiejar.py
index b1da2665be600ba..a1106d786b1dfe3 100644
--- a/Lib/http/cookiejar.py
+++ b/Lib/http/cookiejar.py
@@ -1565,28 +1565,33 @@ def _cookie_from_cookie_tuple(self, tup, request):
         if expires is Absent:
             expires = None
             discard = True
-        elif expires <= self._now:
-            # Expiry date in past is request to delete cookie.  This can't be
-            # in DefaultCookiePolicy, because can't delete cookies there.
-            try:
-                self.clear(domain, path, name)
-            except KeyError:
-                pass
-            _debug("Expiring cookie, domain='%s', path='%s', name='%s'",
-                   domain, path, name)
+
+        cookie = Cookie(version,
+                        name, value,
+                        port, port_specified,
+                        domain, domain_specified, domain_initial_dot,
+                        path, path_specified,
+                        secure,
+                        expires,
+                        discard,
+                        comment,
+                        comment_url,
+                        rest)
+
+        if expires is not None and expires <= self._now:
+            # RFC 6265 section 5.3 ignores the cookie entirely if its Domain
+            # attribute does not match the request host (step 6) before an
+            # existing cookie is removed (steps 11-12)
+            if self._policy.set_ok(cookie, request):
+                try:
+                    self.clear(domain, path, name)
+                except KeyError:
+                    pass
+                _debug("Expiring cookie, domain='%s', path='%s', name='%s'",
+                       domain, path, name)
             return None
 
-        return Cookie(version,
-                      name, value,
-                      port, port_specified,
-                      domain, domain_specified, domain_initial_dot,
-                      path, path_specified,
-                      secure,
-                      expires,
-                      discard,
-                      comment,
-                      comment_url,
-                      rest)
+        return cookie
 
     def _cookies_from_attrs_set(self, attrs_set, request):
         cookie_tuples = self._normalized_cookie_tuples(attrs_set)
