From: yt-download-api maintainers
Subject: [PATCH] avformat/mov: bound repeated PSSH metadata

Keep a per-input limit on DRM metadata, even with the upstream iterative
release and amortized append implementation. YouTube clear streams do not
need large DRM metadata lists.

--- a/libavformat/isom.h
+++ b/libavformat/isom.h
@@ -371,6 +371,7 @@
     MOVFragmentIndex frag_index;
     uint8_t *pssh_side_data;
     unsigned int pssh_side_data_allocated;
+    unsigned int pssh_box_count;
     int atom_depth;
     unsigned int aax_mode;  ///< 'aax' file has been detected
     uint8_t file_key[20];
--- a/libavformat/mov.c
+++ b/libavformat/mov.c
@@ -8368,6 +8368,10 @@
     int ret = 0;
     unsigned int version, kid_count, extra_data_size, alloc_size = 0;
 
+    if (++c->pssh_box_count > 64) {
+        av_log(c->fc, AV_LOG_ERROR, "Too many PSSH metadata records\n");
+        return AVERROR_INVALIDDATA;
+    }
     if (c->fc->nb_streams < 1)
         return 0;
     st = c->fc->streams[c->fc->nb_streams-1];
