# Generate API_KEY with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Replace the placeholder before starting; it is deliberately rejected.
API_KEY=replace-with-a-random-secret-of-at-least-32-characters
REDIS_URL=redis://localhost:6379/0
REDIS_NAMESPACE=yt
TMP_DIR=/tmp/yt-downloads
MAX_DURATION_SECONDS=3600
MAX_FILESIZE_MB=500
MIN_FREE_SPACE_MB=256
FILE_TTL_MINUTES=30
JOB_TIMEOUT_SECONDS=900
SOCKET_TIMEOUT_SECONDS=15
RATE_LIMIT_PER_MINUTE_IP=10
RATE_LIMIT_PER_MINUTE_KEY=30
STATUS_RATE_LIMIT_PER_MINUTE_IP=120
STATUS_RATE_LIMIT_PER_MINUTE_KEY=300
MAX_CONCURRENT_INFO_REQUESTS=2
MAX_CONCURRENT_DOWNLOADS=5
# Standalone server starts one embedded worker. Compose uses a separate worker.
EMBEDDED_WORKERS=1
ENABLE_DOCS=false
PROXY_URL=
# Webhooks are disabled until exact public HTTPS hosts and a signing secret are set.
WEBHOOK_ALLOWED_HOSTS=[]
WEBHOOK_SECRET=
